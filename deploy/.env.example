# Copy to .env next to compose.yml. Never commit .env.

# The wattsim image CI publishes.
WATTSIM_IMAGE=ghcr.io/<owner>/wattsim:latest
# The UI and API, behind the password. Point an A record at the VM.
WATTSIM_DOMAIN=wattsim.example.com
# The test CSMS for outside chargers (wss://<this>/<station id>), with no password. Point an A record at the VM.
WATTSIM_CSMS_DOMAIN=csms.wattsim.example.com
# The shared login.
WATTSIM_USER=team
# From `docker run --rm -it caddy:2 caddy hash-password`. Keep the single quotes: Compose would expand the $ in the hash.
WATTSIM_PASSWORD_HASH='$2a$14$replace-me'
